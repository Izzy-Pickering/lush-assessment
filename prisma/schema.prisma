generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator pothos {
  provider          = "prisma-pothos-types"
  clientOutput      = "../prisma/generated"
  output            = "../lib/pothos-prisma-types.ts"
  generateDatamodel = "true"
}

datasource db {
  provider = "postgresql"
}

model TaskList {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  createdAt     DateTime @default(now())
  numberOfTasks Int      @default(0)
  tasks         Task[]
}

model Task {
  id         Int      @id @default(autoincrement())
  title      String   @unique
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  list       TaskList @relation(fields: [taskListId], references: [id])
  taskListId Int
}
